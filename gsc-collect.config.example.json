  "profileDir": "~/.geo-master/gsc-chrome-profile",
  "outDir": "~/.geo-master/gsc-exports",
  "schedule": { "hour": 9, "minute": 0 },
  "properties": [
    { "label": "Instagram @your_account", "resourceId": "sc-creator-profile:instagram.com/your_account" },
