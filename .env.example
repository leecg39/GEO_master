# 선택 사항: 32바이트 이상 임의 문자열. 미설정 시 data/.master-key를 안전하게 자동 생성합니다.
GEO_MASTER_KEY=
# 선택 사항: 기본값은 data/geo.db
GEO_DB_PATH=


# 선택 사항: 직접 제공자 API 키. 설정 화면의 암호화 키보다 우선합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HYPERCLOVA_API_KEY=

# 선택 사항: 구독핀 공용 키. csk_로 시작해야 하며 OpenAI·Anthropic에 우선 적용됩니다.
GUDOKPIN_API_KEY=
GUDOKPIN_OPENAI_BASE_URL=https://api.gudokpin.com/v1
GUDOKPIN_ANTHROPIC_BASE_URL=https://api.gudokpin.com
GUDOKPIN_OPENAI_MODEL=gpt-5.6-luna
GUDOKPIN_ANTHROPIC_MODEL=claude-sonnet-5