# 선택 사항: 32바이트 이상 임의 문자열. 미설정 시 data/.master-key를 안전하게 자동 생성합니다.
GEO_MASTER_KEY=
# 선택 사항: 기본값은 data/geo.db
GEO_DB_PATH=

# Hostinger Compose에서 주입합니다. 로컬 실행 기본값은 local입니다.
# proxy 모드는 신뢰 프록시의 인증된 사용자와 공유 비밀을 모두 검증합니다.
GEO_AUTH_MODE=local
GEO_ADMIN_USERS=
GEO_AUTH_PROXY_SECRET=


# 선택 사항: 직접 제공자 API 키. 설정 화면의 암호화 키보다 우선합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# 선택 사항: 구독핀 공용 키. csk_로 시작해야 하며 OpenAI·Anthropic에 우선 적용됩니다.
GUDOKPIN_API_KEY=
GUDOKPIN_OPENAI_BASE_URL=https://api.gudokpin.com/v1
GUDOKPIN_ANTHROPIC_BASE_URL=https://api.gudokpin.com
GUDOKPIN_OPENAI_MODEL=gpt-5.6-luna
GUDOKPIN_ANTHROPIC_MODEL=claude-sonnet-5

# SEMForge Pro (월 300,000원) — GEO 실행 기능 게이트
# dev를 명시한 경우만 로컬 테스트 활성화. 실제 과금되지 않습니다.
# live / 미설정: 운영 결제 승인 검증 연동 전까지 checkout·confirm을 503으로 차단합니다.
SEMFORGE_BILLING_MODE=live

# SEMForge 외부 API (서버 env — 구독 활성 시에만 호출)
# TalorData: 설정 화면에서 암호화 저장 가능. 아래 env가 있으면 우선합니다.
TALORDATA_API_TOKEN=
# TalorData 토큰 없이 로컬 데모 SERP (source=mock-dev, 가짜 실측 아님)
SEMFORGE_MOCK_TALORDATA=1
# Firecrawl: 설정 화면에서 암호화 저장 가능. 아래 env가 있으면 우선합니다.
FIRECRAWL_API_KEY=
# Firecrawl 키 없이 로컬 데모 크롤 (source=mock-dev)
SEMFORGE_MOCK_FIRECRAWL=1
PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=
GBP_REDIRECT_URI=
CRON_SECRET=
APP_SECRET=
