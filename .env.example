# 선택 사항: 32바이트 이상 임의 문자열. 미설정 시 data/.master-key를 안전하게 자동 생성합니다.
GEO_MASTER_KEY=
# 선택 사항: 기본값은 data/geo.db
GEO_DB_PATH=

# 로그인 모드
#   local: 로그인 없는 단일 사용자 모드(기본값). 첫 화면이 바로 대시보드입니다.
#   app:   앱 자체 로그인·회원가입. 비로그인 첫 화면은 서비스 소개(/welcome)입니다. HTTPS 또는 localhost에서 사용하세요.
#          인터넷에 공개할 때는 X-Forwarded-For를 덮어쓰는 리버스 프록시 뒤에서 실행해야 주소별 로그인·가입 시도 제한이 정확합니다.
#   proxy: Traefik 신뢰 프록시 뒤 운영 배포(Hostinger Compose가 주입). 로그인·회원가입 동작은 app과 같습니다.
GEO_AUTH_MODE=local

# 관리자 계정 — app·proxy 모드에서 이 아이디·비밀번호로 로그인하면 관리자 권한(회원 승인, SEMForge 결제 면제)을 받습니다.
# 아이디: 이메일 또는 영문·숫자로 시작하는 아이디(영문·숫자·@._+- 최대 128자). 이메일은 대소문자를 구분하지 않습니다.
# 비밀번호: 8자 이상 평문 또는 bcrypt 해시($2b$...). 비워 두면 .env 관리자를 쓰지 않습니다. 값을 바꾸면 기존 관리자 세션이 끊깁니다.
# Compose .env에 $가 들어간 값(해시 등)을 넣을 때는 작은따옴표로 감싸세요.
GEO_ADMIN_ID=
GEO_ADMIN_PASSWORD=

# 회원가입 방식: approval(가입 후 관리자 승인, 기본) / auto(가입 즉시 이용) / closed(신규 가입 중단)
# 모든 계정이 하나의 워크스페이스(프로젝트·측정 데이터)를 공유하므로 공개 운영에서는 approval을 권장합니다.
GEO_SIGNUP_MODE=approval

# 추가 운영 계정(선택): 'user:bcrypt해시' 쉼표 목록과 역할 목록. 관리자·게스트 목록의 아이디는 회원가입으로 선점할 수 없습니다.
GEO_HTTP_AUTH=
GEO_GUEST_USERS=guest
GEO_ADMIN_USERS=
# 세션 서명 비밀(32자 이상). proxy 모드는 필수(Traefik과 같은 값), app 모드는 비워 두면 data/.master-key에서 자동 파생합니다.
GEO_AUTH_PROXY_SECRET=


# 선택 사항: 직접 제공자 API 키. 설정 화면의 암호화 키보다 우선합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# 선택 사항: 구독핀 공용 키. csk_로 시작해야 하며 OpenAI·Anthropic에 우선 적용됩니다.
GUDOKPIN_API_KEY=
GUDOKPIN_OPENAI_BASE_URL=https://api.gudokpin.com/v1
GUDOKPIN_ANTHROPIC_BASE_URL=https://api.gudokpin.com
GUDOKPIN_OPENAI_MODEL=gpt-5.6-luna
GUDOKPIN_ANTHROPIC_MODEL=claude-sonnet-5

# SEMForge Pro (월 300,000원) — GEO 실행 기능 게이트
# dev를 명시한 경우만 로컬 테스트 활성화. 실제 과금되지 않습니다.
# live / 미설정: 운영 결제 승인 검증 연동 전까지 checkout·confirm을 503으로 차단합니다.
SEMFORGE_BILLING_MODE=live

# SEMForge 외부 API (서버 env — 구독 활성 시에만 호출)
# TalorData: 설정 화면에서 암호화 저장 가능. 아래 env가 있으면 우선합니다.
TALORDATA_API_TOKEN=
# TalorData 토큰 없이 로컬 데모 SERP (source=mock-dev, 가짜 실측 아님)
SEMFORGE_MOCK_TALORDATA=1
# Firecrawl: 설정 화면에서 암호화 저장 가능. 아래 env가 있으면 우선합니다.
FIRECRAWL_API_KEY=
# Firecrawl 키 없이 로컬 데모 크롤 (source=mock-dev)
SEMFORGE_MOCK_FIRECRAWL=1
PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=
GBP_REDIRECT_URI=
CRON_SECRET=
APP_SECRET=
